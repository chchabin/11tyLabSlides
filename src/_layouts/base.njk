<!DOCTYPE html>
<html lang="fr-FR">
<head>
    {% include "header.njk" %}
</head>
<body>
{% block content %}
    {{ content | safe }}
{% endblock %}

<script src="{{ '/reveal.js/reveal.js' | url }}"></script>
<script src="{{ '/reveal.js/plugin/markdown/markdown.js' | url }}"></script>
<script src="{{ '/reveal.js/plugin/highlight/highlight.js' | url }}"></script>
<script src="{{ '/reveal.js/plugin/notes/notes.js' | url }}"></script>
<!-- Plugin Mermaid pour reveal.js (mermaid est inclus dans ce bundle) -->
<script src="{{ '/reveal.js/plugin/mermaid/mermaid.js' | url }}"></script>
<script>
    // Le plugin rend chaque <div class="mermaid"> via mermaid.render(),
    // ce qui fonctionne même pour les diagrammes sur des slides masquées.
    Reveal.initialize({
        controls: true,
        progress: true,
        center: true,
        hash: true,
        mermaid: {
            theme: 'dark'
        },
        plugins: [ RevealMarkdown, RevealHighlight, RevealNotes, RevealMermaid ]
    });
</script>
</body>
</html>